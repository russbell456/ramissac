DATABASE_URL=postgresql://usuario:password@localhost:5432/ramissac
SECRET_KEY=cambiar_en_produccion

# Envío de RQ Campo. Para Gmail use una contraseña de aplicación, no su clave normal.
RQ_SMTP_HOST=smtp.gmail.com
RQ_SMTP_PORT=587
RQ_SMTP_USERNAME=correo@gmail.com
RQ_SMTP_PASSWORD=contraseña_de_aplicacion
RQ_SMTP_FROM_EMAIL=correo@gmail.com
RQ_SMTP_USE_TLS=true
RQ_SMTP_USE_SSL=false

# Uno, dos o tres correos separados por coma. También pueden llegar desde Flutter.
RQ_EMAIL_DESTINATARIOS=compras@empresa.com,logistica@empresa.com,gerencia@empresa.com
